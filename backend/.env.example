# Clinica Backend Environment Configuration
# Copy this file to .env:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)

# Database Connection (Default points to docker-compose MySQL)
DB_URL=jdbc:mysql://localhost:3306/clinica
DB_USERNAME=clinica
DB_PASSWORD=clinica

# Server Configuration
SERVER_PORT=8080

# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PayMongo Sandbox Configuration (Optional - for online checkout testing)
# Secret key from PayMongo Dashboard -> Developers -> API Keys (sk_test_...)
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
# Webhook secret from PayMongo Dashboard -> Developers -> Webhooks (whsk_...)
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here
PAYMONGO_SUCCESS_URL=http://localhost:5173/payments?status=success
PAYMONGO_CANCEL_URL=http://localhost:5173/payments?status=cancelled

